<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <AssemblyName>Frontend</AssemblyName>
        <RootNamespace>Frontend</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Same reason as ConsoleGateway: the SDK image does not auto-restore the package
             that carries _framework/blazor.web.js, and without it publish output has no
             Blazor bootstrap script. -->
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Frontend.Shared"/>
    </ItemGroup>

</Project>

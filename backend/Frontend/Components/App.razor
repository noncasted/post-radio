@using Microsoft.AspNetCore.Components.Web
@inject SiteOptions Site

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Post Radio - пост-панк радио: от русского андеграунда до классики</title>
    <base href="/" />
    <link rel="canonical" href="@Site.Url("/")" />
    <meta name="description" content="Непрерывный поток пост-панка с меняющимся визуальным рядом: русский андеграунд, зарубежная классика жанра и редкие записи. Играет в браузере, без регистрации." />
    <meta name="theme-color" content="#0a0a0f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Post Radio" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content="@Site.Url("/")" />
    <meta property="og:title" content="Post Radio - пост-панк радио: от русского андеграунда до классики" />
    <meta property="og:description" content="Пост-панк нон-стоп с меняющимся визуальным рядом - от русского андеграунда до классики жанра. Играет в браузере, без регистрации." />
    <meta property="og:image" content="@Site.Url("favicon.png")" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Post Radio - пост-панк радио: от русского андеграунда до классики" />
    <meta name="twitter:description" content="Пост-панк нон-стоп с меняющимся визуальным рядом - от русского андеграунда до классики жанра. Играет в браузере, без регистрации." />
    <meta name="twitter:image" content="@Site.Url("favicon.png")" />

    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />

    @(StructuredData)
    <style>
        html, body { margin: 0; padding: 0; height: 100%; background: #0a0a0f; color: #e8e8ef; font-family: system-ui, -apple-system, sans-serif; }
        #app { min-height: 100%; }

        #splash {
            position: fixed; inset: 0; z-index: 200;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: radial-gradient(ellipse at center, #1a1a2e 0%, #0a0a0f 70%);
        }
        #splash .ring {
            width: 64px; height: 64px; border-radius: 50%;
            margin-bottom: 1.25rem;
            border: 3px solid rgba(120, 120, 220, 0.15);
            border-top-color: #7a7aff;
            animation: splash-spin 900ms linear infinite;
        }
        #splash .title {
            font-size: 1.1rem; letter-spacing: 0.25em; text-transform: uppercase;
            color: #a8a8c8; opacity: 0.85;
            animation: splash-pulse 1.6s ease-in-out infinite;
        }
        /*
            Crawler-visible copy. #splash is plain server-rendered markup outside the
            interactive island, so it ships in the initial HTML of every response; the
            hydration handler in radio-ui.js drops the whole node once the app paints.
        */
        #splash .seo {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
        }
        @@keyframes splash-spin { to { transform: rotate(360deg); } }
        @@keyframes splash-pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }

        #blazor-error-ui {
            background: lightyellow;
            bottom: 0;
            box-shadow: 0 -1px 2px rgba(0, 0, 0, 0.2);
            display: none;
            left: 0;
            padding: 0.6rem 1.25rem 0.7rem 1.25rem;
            position: fixed;
            width: 100%;
            z-index: 1000;
        }
        #blazor-error-ui .dismiss {
            cursor: pointer;
            position: absolute;
            right: 0.75rem;
            top: 0.5rem;
        }

        /*
            A TV that fell asleep or blinked its Wi-Fi reconnects constantly. The default
            full-screen "Attempting to reconnect" overlay would sit on top of the player,
            so the reconnect UI is a small banner instead, and audio keeps playing under it.
        */
        #components-reconnect-modal {
            display: none;
            position: fixed;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 300;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(18, 18, 26, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #d8d8e8;
            font-size: 12px;
            pointer-events: none;
        }
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected {
            display: block;
        }
        #components-reconnect-modal.components-reconnect-hide { display: none; }
        #components-reconnect-modal .reconnect-failed { display: none; }
        #components-reconnect-modal.components-reconnect-failed .reconnect-retrying,
        #components-reconnect-modal.components-reconnect-rejected .reconnect-retrying { display: none; }
        #components-reconnect-modal.components-reconnect-failed .reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected .reconnect-failed { display: inline; }
    </style>
    <HeadOutlet @rendermode="RenderMode" />
</head>
<body>
    <div id="app">
        <Routes @rendermode="RenderMode" />
    </div>

    <div id="splash">
        <div class="ring"></div>
        <div class="title">Post Radio</div>
        <div class="seo">
            <h1>Post Radio - пост-панк радио онлайн</h1>
            <p>
                Post Radio - это круглосуточный поток пост-панка, который играет прямо в браузере.
                От русского андеграунда - полузабытых кассетных записей и самиздата - до классики
                жанра: новой волны, колд-вейва и готик-рока.
            </p>
            <p>
                Каждый трек идёт со своим визуальным рядом: обложки и кадры меняются вместе с музыкой.
                Можно переключать плейлисты, смотреть данные текущей песни и пропускать то, что не зашло.
                Без регистрации, установки и рекламы.
            </p>
            <p>
                Название пишут по-разному - Post Radio, Postradio, «Пост Радио», - это одно и то же радио.
            </p>
            <p>
                Что нового в эфире - в Telegram-канале
                <a href="https://t.me/posttradio">@@posttradio</a>.
            </p>
            <p>Если плеер не загрузился, включите JavaScript и обновите страницу.</p>
        </div>
    </div>

    @*
        Wrapped in Yandex noindex comments: both blocks are display:none until something
        breaks, but they still ship in the html, and Yandex has pulled the error text into
        the search snippet in place of the page description. Google ignores the comments.
    *@
    @NoIndexOpen
    <div id="components-reconnect-modal">
        <span class="reconnect-retrying">Соединение восстанавливается...</span>
        <span class="reconnect-failed">Соединение потеряно. <a href="">Обновить</a></span>
    </div>

    <div id="blazor-error-ui">
        Что-то пошло не так.
        <a href="." class="reload">Обновить страницу</a>
        <span class="dismiss">x</span>
    </div>
    @NoIndexClose

    <script src="@Assets["js/radio-core.js"]"></script>
    <script src="@Assets["js/radio-presence.js"]"></script>
    <script src="@Assets["js/radio-player.js"]"></script>
    <script src="@Assets["js/radio-images.js"]"></script>
    <script src="@Assets["js/radio-ui.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 100,
                    retryIntervalMilliseconds: 2000
                }
            }
        });
    </script>
</body>
</html>

@code {
    /*
        Prerendered so crawlers get the real page, not just the splash. Every JS call in
        this app lives in OnAfterRenderAsync(firstRender), which Blazor does not invoke
        during the prerender pass (there is no JS runtime yet) - it fires once, after the
        circuit is up and the DOM is hydrated. That is the callback the player hangs off,
        so prerendering costs nothing on the interop side.
    */
    private static readonly InteractiveServerRenderMode RenderMode = new(prerender: true);

    /*
        Emitted as raw markup rather than written inline: Razor html-encodes attribute
        values, which turns the "+" of application/ld+json into "&#x2B;". Parsers decode
        that back, but crawlers have no reason to be handed a mangled mime type.
    */
    /*
        Razor strips html comments from rendered output, so the Yandex noindex markers
        have to be emitted as raw markup or they never reach the page.
    */
    private static readonly MarkupString NoIndexOpen = (MarkupString)"<!--noindex-->";
    private static readonly MarkupString NoIndexClose = (MarkupString)"<!--/noindex-->";

    private MarkupString StructuredData => (MarkupString)$$"""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "RadioStation",
            "name": "Post Radio",
            "alternateName": ["Postradio", "PostRadio", "Пост Радио", "Пострадио", "post-radio.ru"],
            "url": "{{Site.Url("/")}}",
            "logo": "{{Site.Url("favicon.png")}}",
            "description": "Пост-панк радио: непрерывный поток от русского андеграунда до классики жанра, с меняющимся визуальным рядом.",
            "sameAs": "https://t.me/posttradio",
            "knowsAbout": ["пост-панк", "post-punk", "русский андеграунд", "новая волна", "готик-рок", "колд-вейв"]
        }
        </script>
        """;
}

@using Frontend.Services
@implements IDisposable

@if (!State.IsStarted)
{
    <button class="start-btn" @onclick="StartFromClick">Play</button>
}

<style>
    .start-btn {
        position: fixed;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        height: 70px; width: 300px;
        font-size: 2rem;
        background: #7e6fff;
        color: #fff;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        z-index: 100;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }
    .start-btn:hover { background: #6a5cff; }
</style>

@code {
    [Parameter] public required SessionState State { get; set; }

    private Action? _startedHandler;

    protected override void OnInitialized()
    {
        // The transport play button can start playback too, so the overlay follows the
        // session instead of its own click.
        _startedHandler = () => _ = InvokeAsync(StateHasChanged);
        State.Started += _startedHandler;
    }

    public void Dispose()
    {
        if (_startedHandler != null)
            State.Started -= _startedHandler;
    }

    private void StartFromClick() => State.InvokeStart();
}

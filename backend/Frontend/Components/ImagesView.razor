@using Frontend.Services
@using Microsoft.JSInterop
@inject IRadioApi Api
@inject IJSRuntime JS
@inject ILogger<ImagesView> Logger
@implements IAsyncDisposable

@*
    Slot A carries the first picture already in the prerendered html, so the browser starts
    the 250 KB download while the circuit is still negotiating instead of after it is up.
    Everything past that is owned by radio-images.js: it recognises the primed slot and
    reuses it rather than fading a second copy in.
*@
<div class="image-container">
    <img id="image-a-left" class="image sub blurry" style="position: fixed; left: 0; z-index: -1@(PrimedStyle)" src="@_primedUrl" alt="" />
    <img id="image-a-right" class="image sub blurry" style="position: fixed; left: 50%; z-index: -1@(PrimedStyle)" src="@_primedUrl" alt="" />
    <img id="image-a-main" class="image main" style="z-index: 1@(PrimedStyle)" src="@_primedUrl" alt="" />
    <img id="image-b-left" class="image sub blurry" style="position: fixed; left: 0; z-index: -1" alt="" />
    <img id="image-b-right" class="image sub blurry" style="position: fixed; left: 50%; z-index: -1" alt="" />
    <img id="image-b-main" class="image main" style="z-index: 1" alt="" />
</div>

<style>
    .image-container {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0a0a14;
    }
    .image {
        position: absolute;
        object-fit: cover;
        object-position: center;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
    .sub { height: 100%; width: 50%; }
    .main { height: 115%; }
    .blurry { filter: blur(18px); }
</style>

@code {
    [Parameter] public required SessionState State { get; set; }

    [Inject] private PersistentComponentState PersistentState { get; set; } = null!;

    private const int BatchSize = 24;
    private const string PrimedUrlKey = "images.primed";

    private static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(15);

    private DotNetObjectReference<ImagesView>? _dotNetRef;
    private CancellationTokenSource? _componentCts;
    private PersistingComponentStateSubscription _persistSubscription;
    private string? _primedUrl;
    private bool _disposed;

    private CancellationToken Token => _componentCts?.Token ?? State.Token;

    private string PrimedStyle => string.IsNullOrEmpty(_primedUrl) ? string.Empty : "; opacity: 1";

    protected override void OnInitialized()
    {
        _componentCts = CancellationTokenSource.CreateLinkedTokenSource(State.Token);
    }

    protected override async Task OnInitializedAsync()
    {
        _persistSubscription = PersistentState.RegisterOnPersisting(PersistPrimedUrl);

        // The interactive pass must reuse the url the prerender put in the markup, otherwise
        // the browser downloads one picture and the slideshow then shows a different one.
        if (PersistentState.TryTakeFromJson<string>(PrimedUrlKey, out var persisted))
        {
            _primedUrl = persisted;
            return;
        }

        if (RendererInfo.IsInteractive)
            return;

        var batch = await Api.GetImageBatch(State.TakeImageRange(1), 1);
        _primedUrl = batch.Urls.FirstOrDefault();
    }

    private Task PersistPrimedUrl()
    {
        PersistentState.PersistAsJson(PrimedUrlKey, _primedUrl);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _dotNetRef = DotNetObjectReference.Create(this);
        var urls = await FetchBatch(_primedUrl);

        var options = new
        {
            intervalMs = State.Options.ImageSwitchIntervalMs,
            fadeMs = State.Options.ImageFadeMs
        };

        await InvokeJs("radioImages.start", _dotNetRef, urls, options);

        if (urls.Count == 0)
            _ = RetryLater();
    }

    [JSInvokable]
    public async Task OnImagesNeeded(int currentCount)
    {
        if (_disposed)
            return;

        var urls = await FetchBatch();

        if (urls.Count == 0)
        {
            _ = RetryLater();
            return;
        }

        await InvokeJs("radioImages.append", urls);
    }

    /// <summary>
    /// One gateway call per batch. Resolving urls one index at a time used to cost
    /// <see cref="BatchSize"/> sequential round trips before the first background could paint.
    /// </summary>
    private async Task<IReadOnlyList<string>> FetchBatch(string? primed = null)
    {
        if (_disposed || Token.IsCancellationRequested)
            return Array.Empty<string>();

        var batch = await Api.GetImageBatch(State.TakeImageRange(BatchSize), BatchSize);
        var urls = batch.Urls.Where(url => !string.IsNullOrWhiteSpace(url)).ToList();

        if (string.IsNullOrEmpty(primed))
            return urls;

        // Keep the primed picture first: JS shows it straight from the slot the prerender
        // filled instead of fading in a second one the browser has yet to fetch.
        urls.Insert(0, primed);
        return urls;
    }

    private async Task RetryLater()
    {
        try
        {
            await Task.Delay(RetryDelay, Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_disposed)
            return;

        var urls = await FetchBatch();

        if (urls.Count == 0)
        {
            _ = RetryLater();
            return;
        }

        await InvokeJs("radioImages.append", urls);
    }

    private async Task InvokeJs(string identifier, params object?[] args)
    {
        if (_disposed)
            return;

        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (Exception e)
        {
            Logger.LogWarning(e, "[ImagesView] JS call failed identifier={Identifier}", identifier);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _persistSubscription.Dispose();
        _componentCts?.Cancel();

        try
        {
            await JS.InvokeVoidAsync("radioImages.dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }

        _dotNetRef?.Dispose();
        _componentCts?.Dispose();
    }
}

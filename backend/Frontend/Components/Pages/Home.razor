@page "/"
@using Frontend.Services
@inject IRadioApi Api
@implements IDisposable

@*
    No PageTitle here: App.razor already sets the crawler-facing <title>, and anything
    rendered through HeadOutlet lands after it and wins, so a second title would quietly
    undo it. Reintroduce this only with the full title text.
*@

<TelegramLink />
<ImagesView State="@_state" />
<AudioPlayer State="@_state" />
<SongDataView State="@_state" />
<ControlsView State="@_state" />
<SkipNotifications State="@_state" />
<StartWait State="@_state" />

@code {
    private SessionState _state = null!;

    protected override async Task OnInitializedAsync()
    {
        _state = new SessionState(Api);

        // OnInitializedAsync runs twice under prerendering. Options only feed the volume
        // slider and the JS player config, and neither is observable in the prerendered
        // frame, so fetching them there would just double the load on meta for nothing.
        // SessionState ships usable defaults until the interactive pass arrives.
        if (!RendererInfo.IsInteractive)
            return;

        await _state.LoadOptions();
    }

    public void Dispose() => _state.Dispose();
}
